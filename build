#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

VENV="$ROOT/.venv"
if [ ! -x "$VENV/bin/python" ]; then
  "${PYTHON:-python3}" -m venv "$VENV"
fi
"$VENV/bin/python" -m pip install --quiet --upgrade pip
"$VENV/bin/python" -m pip install --quiet -r "$ROOT/src/requirements.txt" pyinstaller

"$VENV/bin/python" -m PyInstaller \
  --noconfirm --clean \
  --onefile --noconsole \
  --name majestic-rp-linux \
  --distpath "$ROOT/dist" \
  --workpath "$ROOT/.pyinstaller/work" \
  --specpath "$ROOT/.pyinstaller" \
  --paths "$ROOT/src" \
  --paths "$ROOT/src/app" \
  --add-data "$ROOT/src/assets:assets" \
  --hidden-import backend.patch \
  --hidden-import backend.patch_proton \
  --hidden-import backend.steam \
  --hidden-import backend.logs \
  --hidden-import i18n \
  --hidden-import PySide6.QtSvg \
  "$ROOT/src/app/app.py"

echo "Готово: dist/majestic-rp-linux"