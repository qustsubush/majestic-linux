#!/bin/bash

set -euo pipefail

APPID=271590
GTA_DIR_NAME="Grand Theft Auto V"
SETUP_URL="https://cdn.majestic-files.net/launcher/cis/MajesticLauncherSetup.exe"

STEAM_ROOT="$HOME/.local/share/Steam"
if [ ! -d "$STEAM_ROOT/steamapps" ]; then
    STEAM_ROOT="$(readlink -f "$HOME/.steam/steam" 2>/dev/null || true)"
fi

PFX="$STEAM_ROOT/steamapps/compatdata/$APPID/pfx"
LAUNCHER="$PFX/drive_c/users/steamuser/AppData/Local/MajesticLauncher/Majestic Launcher.exe"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/majestic-linux"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/majestic-linux"

LAUNCHER_PROC='^[A-Za-z]:\\.*Majestic Launcher\.exe'

TERMINAL_PID=$(ps -o ppid= -p $$ | tr -d ' ')

pause() {
    if [ -t 0 ]; then
        read -rp "Нажмите Enter, чтобы закрыть окно..." _ || true
    fi
}

die() {
    printf '\n%s\n\n' "$*" >&2
    pause
    exit 1
}

strw() {
    local w
    w=$(printf '%s' "$1" | LC_ALL=C.UTF-8 wc -m)
    echo "${w//[[:space:]]/}"
}

term_cols() { tput cols 2>/dev/null || echo 80; }
term_rows() { tput lines 2>/dev/null || echo 24; }

max_width() {
    local line w max=0
    while IFS= read -r line; do
        w=$(strw "$line")
        if (( w > max )); then max=$w; fi
    done
    echo "$max"
}

center_block() {
    local cols=$1 max=0 w pad line
    local -a lines=()
    while IFS= read -r line; do
        lines+=("$line")
        w=$(strw "$line")
        if (( w > max )); then max=$w; fi
    done
    pad=$(( (cols - max) / 2 ))
    if (( pad < 0 )); then pad=0; fi
    for line in "${lines[@]}"; do
        printf '%*s%s\n' "$pad" '' "$line"
    done
}

